{
  "name": "@office-foodie/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test:gemini": "node --env-file-if-exists=.env test/verify-gemini-live.mjs",
    "test": "pnpm --filter @office-foodie/shared build && pnpm build && node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@office-foodie/shared": "workspace:*",
    "@prisma/client": "6.19.0",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "jest": "^30.5.2",
    "prisma": "6.19.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "type": "module"
}
